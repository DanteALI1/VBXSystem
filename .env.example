# VBXSystem — local / compose environment (compatible with deploy/redos)

VBX_HOST=localhost
VBX_SCHEME=http
VBX_HTTP_PORT=80
VBX_HTTPS_PORT=443
VBX_API_PORT=8000
VBX_PUBLIC_URL=http://localhost

VBX_SECRET_KEY=dev-secret-change-me-please
VBX_POSTGRES_DB=vbx
VBX_POSTGRES_USER=vbx
VBX_POSTGRES_PASSWORD=vbx_dev_password
VBX_REDIS_PASSWORD=vbx_redis_password
VBX_NVD_API_KEY=

VBX_ADMIN_USERNAME=admin
VBX_ADMIN_EMAIL=admin@example.local
VBX_ADMIN_PASSWORD=ChangeMe_StrongPass_123!
VBX_ADMIN_FULL_NAME=Главный Администратор
VBX_ADMIN_ORG=ООО Пример
VBX_ADMIN_TITLE=Администратор ИБ
VBX_ADMIN_PHONE=+7-900-000-00-00

VBX_TIMEZONE=Europe/Moscow
VBX_PROFILE=dev
# Leave empty to derive from VBX_PROFILE (prod → live EPSS). Set true/false to force.
# VBX_EPSS_MOCK=true
# HttpOnly cookie session via Next BFF (dual-path with Bearer)
VBX_AUTH_COOKIES=false
VBX_COOKIE_SECURE=false
VBX_POSTGRES_MEM_LIMIT=2g
VBX_API_MEM_LIMIT=2g
VBX_WEB_MEM_LIMIT=1g
TZ=Europe/Moscow

# Constructed URLs used by containers
VBX_DATABASE_URL=postgresql+psycopg://vbx:${VBX_POSTGRES_PASSWORD}@postgres:5432/vbx
VBX_REDIS_URL=redis://:${VBX_REDIS_PASSWORD}@redis:6379/0
VBX_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
VBX_API_INTERNAL_URL=http://api:8000

# Hardening (optional prod)
# VBX_TRUSTED_HOSTS=vbx.example.local,localhost
# VBX_MAX_UPLOAD_BYTES=67108864
# VBX_MAX_BDU_UPLOAD_BYTES=67108864
# VBX_MAX_XDB_UPLOAD_BYTES=33554432
