# First admin — create with: npm run bootstrap:admin
BOOTSTRAP_ADMIN_EMAIL=admin@local.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
NVD_API_KEY=
NVD_SYNC_DAYS=30
# live (default) | fixture — process tests/fixtures/nvd-fragment.json without network
NVD_SYNC_MODE=live
BDU_XML_URL=https://bdu.fstec.ru/files/documents/vulxml.xml
# live (default) | fixture — process tests/fixtures/bdu-mini.xml
BDU_SYNC_MODE=live
APP_URL=http://localhost:3000
