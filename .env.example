# VBXSystem — local / compose environment (compatible with deploy/redos)

VBX_HOST=localhost
VBX_SCHEME=http
VBX_HTTP_PORT=80
VBX_HTTPS_PORT=443
VBX_API_PORT=8000
VBX_PUBLIC_URL=http://localhost

VBX_SECRET_KEY=dev-secret-change-me-please
VBX_POSTGRES_DB=vbx
VBX_POSTGRES_USER=vbx
VBX_POSTGRES_PASSWORD=vbx_dev_password
VBX_REDIS_PASSWORD=vbx_redis_password
VBX_NVD_API_KEY=

VBX_ADMIN_USERNAME=admin
VBX_ADMIN_EMAIL=admin@example.local
VBX_ADMIN_PASSWORD=ChangeMe_StrongPass_123!
VBX_ADMIN_FULL_NAME=Главный Администратор
VBX_ADMIN_ORG=ООО Пример
VBX_ADMIN_TITLE=Администратор ИБ
VBX_ADMIN_PHONE=+7-900-000-00-00

VBX_TIMEZONE=Europe/Moscow
VBX_PROFILE=dev
# Leave empty to derive from VBX_PROFILE (prod → live EPSS). Set true/false to force.
# VBX_EPSS_MOCK=true
# Store full NVD raw_json on sync (false → stub). Default false (prod-safe / saves disk).
# Set true only if you need full NVD payloads in DB. Also Settings → Database.
# VBX_CVE_STORE_RAW_JSON=false
# Auth cookies: leave unset/empty to follow profile (prod → HttpOnly cookies via Next BFF).
# Set true/false explicitly to override. Bearer+localStorage remains for tests / VBX_AUTH_COOKIES=false.
# VBX_AUTH_COOKIES=
VBX_COOKIE_SECURE=false
# Public web origin for SSO redirect_uri default ({VBX_PUBLIC_URL}/api/auth/sso/callback)
# For local Next on :3000 use http://localhost:3000
# VBX_PUBLIC_URL is also used by deploy; API reads VBX_PUBLIC_URL as this value when set.
VBX_POSTGRES_MEM_LIMIT=2g
VBX_API_MEM_LIMIT=2g
VBX_WEB_MEM_LIMIT=1g
TZ=Europe/Moscow

# Constructed URLs used by containers
VBX_DATABASE_URL=postgresql+psycopg://vbx:${VBX_POSTGRES_PASSWORD}@postgres:5432/vbx
VBX_REDIS_URL=redis://:${VBX_REDIS_PASSWORD}@redis:6379/0
VBX_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
VBX_API_INTERNAL_URL=http://api:8000

# Scanner modules (optional: docker-compose.scanners.yml --profile nmap|shodan|zap|nuclei|gowitness|discovery)
VBX_MODULE_TOKEN=dev-module-token-change-me
# Optional per-module tokens (override shared token for that worker only):
# VBX_MODULE_TOKEN_NMAP=
# VBX_MODULE_TOKEN_SHODAN=
# VBX_MODULE_TOKEN_ZAP=
# VBX_MODULE_TOKEN_NUCLEI=
# VBX_MODULE_TOKEN_GOWITNESS=
# VBX_MODULE_TOKEN_DISCOVERY=
# Or inject via secret manager prefix / file:
# VBX_SECRET__VBX_MODULE_TOKEN=...
# VBX_SECRET_FILE__VBX_SHODAN_API_KEY=/run/secrets/shodan_api_key
# Prefer worker env / docker secret for Shodan — Core no longer ships plaintext key via GET config.
# VBX_SCAN_ALLOWLIST=127.0.0.1,host.docker.internal,scan-target,8.8.8.8,http://scan-target
# VBX_SHODAN_API_KEY=
# VBX_SHODAN_MOCK=true
# VBX_DISCOVERY_MOCK=true
# VBX_ZAP_TIMEOUT=300
# VBX_ZAP_MOCK=false
# VBX_ZAP_API_URL=http://127.0.0.1:8080
# VBX_ZAP_START_DAEMON=true
# VBX_ZAP_API_KEY=
# VBX_NUCLEI_TEMPLATES=/app/artifacts/nuclei-templates
# VBX_NUCLEI_TEMPLATES_DIR=/app/artifacts/nuclei-templates
# VBX_NUCLEI_CUSTOM_DIR=/app/artifacts/nuclei-custom
# NUCLEI_TEMPLATES_AUTO_SYNC=true
# VBX_NUCLEI_RATE_LIMIT=150
# VBX_NUCLEI_TIMEOUT=900
# VBX_NUCLEI_MOCK=false
# VBX_GOWITNESS_TIMEOUT=60
# VBX_GOWITNESS_RESOLUTION=1440x900
# VBX_GOWITNESS_MOCK=false
# Screenshots: worker gowitness_data → /data; API mounts same volume at
# /app/artifacts/gowitness. Ingest rewrites evidence → artifact_key under VBX_ARTIFACTS_DIR.
# VBX_ARTIFACTS_DIR=/app/artifacts
# Nuclei pack: volume nuclei_templates → /app/artifacts/nuclei-templates (API + scanner-nuclei)
# Custom YAML uploads: volume nuclei_custom → /app/artifacts/nuclei-custom
# Optional: override internal module API rate limit (default 120/min; pytest uses 10000)
# VBX_MODULE_RATE_LIMIT=120

# Hardening (optional prod)
# VBX_TRUSTED_HOSTS=vbx.example.local,localhost
# VBX_MAX_UPLOAD_BYTES=67108864
# VBX_MAX_BDU_UPLOAD_BYTES=67108864
# VBX_MAX_XDB_UPLOAD_BYTES=33554432
# Opt-in XDB metadata URL fetch stub (POST /xdb/connector/fetch)
# VBX_XDB_CONNECTOR_ENABLED=false
# VBX_XDB_FEED_URL=
