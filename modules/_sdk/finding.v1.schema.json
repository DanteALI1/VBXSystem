{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vbxsystem.local/schemas/finding.v1.json",
  "title": "VBXSystem finding.v1",
  "type": "object",
  "required": ["schema", "finding_type", "severity", "title", "target", "module_id"],
  "properties": {
    "schema": { "const": "finding.v1" },
    "finding_type": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "target": { "type": "string" },
    "asset": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "ip": { "type": "string" },
        "hostname": { "type": "string" },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": {},
              "protocol": { "type": "string" },
              "state": { "type": "string" }
            }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "cve_ids": { "type": "array", "items": { "type": "string" } },
    "bdu_ids": { "type": "array", "items": { "type": "string" } },
    "module_id": { "type": "string" },
    "observed_at": { "type": "string" }
  },
  "additionalProperties": true
}
